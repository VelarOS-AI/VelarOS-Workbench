{
  "name": "velaros-workbench",
  "version": "0.3.20",
  "private": true,
  "description": "VelarOS Workbench standalone Electron IDE.",
  "desktopName": "velaros-workbench.desktop",
  "author": {
    "name": "VelarOS",
    "email": "zhenglian0906@gmail.com"
  },
  "type": "module",
  "main": "./build/electron/main/index.js",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "predev": "node scripts/ensureElectronInstalled.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "check:boundaries": "node scripts/checkProductBoundaries.mjs",
    "test": "bun test tests",
    "test:velar:installed": "bun --conditions=source scripts/test/verifyInstalledVelarToolchain.ts",
    "probe:watch": "bun --conditions=source src/main/workspace/watch/watchProbe.ts",
    "probe:terminal": "bun --conditions=source src/main/workspace/terminal/terminalProbe.ts",
    "probe:git": "bun --conditions=source src/main/workspace/git/gitProbe.ts",
    "probe:kernel-host": "bun --conditions=source src/main/kernel/kernelHostProbe.ts",
    "probe": "bun run probe:watch && bun run probe:git && bun run probe:terminal && bun run probe:kernel-host",
    "check:platform-packages": "bun scripts/refreshPrivatePackageLock.mjs --validate-only",
    "check": "bun run check:boundaries && bun run check:platform-packages && bun run typecheck && bun run lint && bun run test && bun run probe && bun run build",
    "package:mac": "bun run build && node scripts/release/packageMac.mjs",
    "package:dir": "bun run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.yml --mac --dir -c.mac.identity=null -c.mac.notarize=false",
    "verify:dir": "node scripts/release/verifyPackagedWorkbench.mjs",
    "package:win": "bun run build && electron-builder --config electron-builder.yml --win",
    "package:linux": "bun run build && electron-builder --config electron-builder.yml --linux"
  },
  "dependencies": {
    "gpt-tokenizer": "3.4.0",
    "pyright": "^1.1.411",
    "typescript": "^5.9.3",
    "vscode-css-languageservice": "^6.3.10",
    "vscode-html-languageservice": "^5.6.2",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-markdown-languageservice": "^0.5.0",
    "vscode-uri": "^3.1.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.39.4",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.10",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.19.17",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@velaros-ai/agent": "0.6.7",
    "@velaros-ai/browser": "0.2.13",
    "@velaros-ai/core": "0.4.0",
    "@velaros-ai/development": "1.0.4",
    "@velaros-ai/kernel": "0.2.1",
    "@velaros-ai/model": "0.4.12",
    "@velaros-ai/project": "2.0.6",
    "@velaros-ai/system": "1.1.3",
    "@velaros-ai/ui": "0.2.29",
    "@vitejs/plugin-react": "^4.3.0",
    "ahooks": "^3.9.7",
    "ai": "^6.0.168",
    "builder-util-runtime": "^9.7.0",
    "diff": "^8.0.4",
    "electron": "^41.10.2",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "execa": "^9.6.1",
    "globals": "^17.6.0",
    "markdown-it": "^15.0.0",
    "react": "^19.2.5",
    "react-arborist": "^3.5.0",
    "react-dom": "^19.2.5",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwindcss": "^4.0.0",
    "tar": "^7.5.2",
    "tinykeys": "3.0.0",
    "vite": "^7.3.2",
    "zod": "^4.3.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelarOS-AI/VelarOS-Workbench.git"
  },
  "patchedDependencies": {
    "vscode-markdown-languageservice@0.5.0": "patches/vscode-markdown-languageservice@0.5.0.patch"
  }
}
