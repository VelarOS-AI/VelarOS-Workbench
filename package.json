{
  "name": "velaros-workbench",
  "version": "0.3.2",
  "private": true,
  "description": "VelarOS Workbench independent IDE product and reusable product boundary.",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "bun run --cwd apps/workbench dev",
    "build:package": "bun run --cwd packages/workbench build",
    "build:app": "bun run --cwd apps/workbench build",
    "build": "bun run build:package && bun run build:app",
    "typecheck": "node scripts/run-workspace-script.mjs typecheck && bun run --cwd apps/workbench typecheck",
    "lint": "eslint . --max-warnings=0",
    "check:boundaries": "node scripts/checkProductBoundaries.mjs",
    "check:package-contracts": "node scripts/checkPackageContracts.mjs",
    "test": "bun test tests",
    "probe:app": "bun run --cwd apps/workbench probe:watch && bun run --cwd apps/workbench probe:grammar && bun run --cwd apps/workbench probe:git && bun run --cwd apps/workbench probe:terminal",
    "probe": "bun run build:package && bun run probe:app",
    "check": "bun run check:boundaries && bun run build:package && bun run check:package-contracts && bun run typecheck && bun run lint && bun run test && bun run probe:app && bun run build:app",
    "package:grammars": "node scripts/build/packageLanguageGrammars.mjs",
    "package:mac": "bun run build && electron-builder --config apps/workbench/electron-builder.yml --mac",
    "package:app:dir": "bun run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config apps/workbench/electron-builder.yml --mac --dir -c.mac.identity=null -c.mac.notarize=false",
    "verify:app:dir": "node scripts/release/verifyPackagedApp.mjs",
    "package:win": "bun run build && electron-builder --config apps/workbench/electron-builder.yml --win",
    "package:linux": "bun run build && electron-builder --config apps/workbench/electron-builder.yml --linux",
    "link:local": "node scripts/dev/link-local-packages.mjs",
    "release:dry-run": "node scripts/release/publish-packages.mjs --dry-run",
    "release:packages": "node scripts/release/publish-packages.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.39.4",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.10",
    "@types/node": "^22.19.17",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^41.10.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelarOS-AI/VelarOS-Workbench.git"
  },
  "dependencies": {
    "@velaros-ai/kernel-client": "^0.3.0"
  }
}
