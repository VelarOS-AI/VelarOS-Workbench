{
  "name": "velaros-workbench",
  "version": "0.4.22",
  "private": true,
  "license": "Apache-2.0",
  "description": "VelarOS Workbench standalone Electron IDE.",
  "desktopName": "velaros-workbench.desktop",
  "author": {
    "name": "VelarOS",
    "email": "zhenglian0906@gmail.com"
  },
  "type": "module",
  "main": "./build/electron/main/index.js",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "predev": "node scripts/ensureElectronInstalled.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/checkBuildBudgets.mjs",
    "typecheck": "node scripts/typecheck/runTypecheckPartitions.mjs",
    "lint": "node scripts/checks/runLint.mjs",
    "check:boundaries": "node scripts/checkProductBoundaries.mjs",
    "test": "node scripts/test/runIsolatedTests.mjs && node --test scripts/release/publishUpdateCatalog.test.mjs scripts/test/conversationRuntime.test.mjs",
    "test:velar:installed": "bun --conditions=source scripts/test/verifyInstalledVelarToolchain.ts",
    "probe:watch": "bun --conditions=source src/main/workspace/watch/watchProbe.ts",
    "probe:terminal": "node scripts/probe/runTerminalProbe.mjs",
    "probe:git": "bun --conditions=source src/main/workspace/git/gitProbe.ts",
    "probe:debug": "node scripts/probe/runDebugProbe.mjs",
    "probe": "bun run probe:watch && bun run probe:git && bun run probe:terminal && bun run probe:debug",
    "check:platform-packages": "bun scripts/refreshPrivatePackageLock.mjs --validate-only",
    "check:bundle-budget": "node scripts/checkBuildBudgets.mjs",
    "check": "bun run check:boundaries && bun run check:platform-packages && bun run typecheck && bun run lint && bun run test && bun run probe && bun run build",
    "package:mac": "bun run build && bun run prepare:agent-runtime && node scripts/release/packageMac.mjs",
    "package:dir": "bun run build && bun run prepare:agent-runtime && node scripts/release/ensureTerminalBackends.mjs darwin && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.yml --mac --dir -c.mac.identity=null -c.mac.notarize=false -c.mac.forceCodeSigning=false",
    "verify:dir": "node scripts/release/verifyPackagedWorkbench.mjs",
    "package:win": "bun run build && bun run prepare:agent-runtime && node scripts/release/ensureTerminalBackends.mjs win32 && electron-builder --config electron-builder.yml --win --publish never && node scripts/release/finalizeWindowsUpdate.mjs",
    "package:linux": "bun run build && bun run prepare:agent-runtime && node scripts/release/ensureTerminalBackends.mjs linux && electron-builder --config electron-builder.yml --linux --publish never",
    "release:local:stage": "node scripts/release/releaseArtifacts.mjs stage",
    "release:local:verify": "node scripts/release/releaseArtifacts.mjs verify",
    "release:local:finalize": "node scripts/release/publishUpdateCatalog.mjs",
    "prepare:agent-runtime": "node scripts/release/prepareNodeRuntime.mjs",
    "format": "node scripts/formatChanged.mjs"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@radix-ui/colors": "3.0.0",
    "gpt-tokenizer": "3.4.0",
    "pyright": "^1.1.411",
    "react": "^19.2.5",
    "typescript": "^5.9.3",
    "vscode-css-languageservice": "^6.3.10",
    "vscode-html-languageservice": "^5.6.2",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-markdown-languageservice": "^0.5.0",
    "vscode-uri": "^3.1.0",
    "@velaros-ai/velaros": "https://github.com/VelarOS-AI/VelarOS-Platform/releases/download/v0.7.13/velaros-ai-velaros-0.12.1.tgz",
    "@velaros-ai/capabilities": "https://github.com/VelarOS-AI/VelarOS-Platform/releases/download/v0.7.13/velaros-ai-capabilities-0.12.1.tgz",
    "@vue/language-server": "2.2.12"
  },
  "devDependencies": {
    "@ast-grep/napi": "0.45.3",
    "@playwright/test": "1.63.0",
    "jsonc-parser": "3.3.1",
    "prettier": "3.9.9",
    "ts-morph": "28.0.0",
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@electron/notarize": "2.5.0",
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.39.4",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.10",
    "@phosphor-icons/react": "^2.1.10",
    "@replit/codemirror-vim": "^6.4.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.19.17",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-react": "^4.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "ahooks": "^3.9.7",
    "ai": "^6.0.168",
    "builder-util-runtime": "^9.7.0",
    "diff": "^8.0.4",
    "electron": "^41.10.2",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "execa": "^9.6.1",
    "extract-zip": "2.0.1",
    "globals": "^17.6.0",
    "js-yaml": "4.3.0",
    "jszip": "3.10.1",
    "markdown-it": "^15.0.0",
    "react-arborist": "^3.5.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwindcss": "^4.0.0",
    "tar": "^7.5.2",
    "tinykeys": "3.0.0",
    "vite": "^7.3.2",
    "zod": "^4.3.6",
    "npm": "12.2.0",
    "@velaros-ai/ui": "https://github.com/VelarOS-AI/VelarOS-UI/releases/download/v1.1.3/velaros-ai-ui-1.1.3.tgz",
    "@typescript/native": "npm:typescript@7.0.2",
    "react-dom": "^19.2.5",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-less": "^6.0.2",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/lang-vue": "^0.1.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelarOS-AI/VelarOS-Workbench.git"
  },
  "patchedDependencies": {
    "vscode-markdown-languageservice@0.5.0": "patches/vscode-markdown-languageservice@0.5.0.patch"
  },
  "optionalDependencies": {
    "node-bin-darwin-arm64": "24.22.0",
    "node-darwin-x64": "24.22.0",
    "node-linux-arm64": "24.22.0",
    "node-linux-x64": "24.22.0",
    "node-win-arm64": "24.22.0",
    "node-win-x64": "24.22.0"
  }
}
