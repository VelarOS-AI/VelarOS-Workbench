{
  "name": "@velaros-ai/workbench-app",
  "version": "0.3.2",
  "description": "VelarOS Workbench standalone Electron IDE application.",
  "author": "VelarOS",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "probe:watch": "bun --conditions=source src/main/workspace/watch/watchProbe.ts",
    "probe:grammar": "bun --conditions=source src/main/resources/languageGrammarProbe.ts",
    "probe:terminal": "bun --conditions=source src/main/workspace/terminal/terminalProbe.ts",
    "probe:git": "bun --conditions=source src/main/workspace/git/gitProbe.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@phosphor-icons/react": "^2.1.10",
    "@velaros-ai/agent-runtime": "^0.4.2",
    "@velaros-ai/browser-composition": "^0.2.4",
    "@velaros-ai/browser-core": "^0.2.5",
    "@velaros-ai/browser-runtime": "^0.2.4",
    "@velaros-ai/core": "^0.3.2",
    "@velaros-ai/kernel-sdk": "file:../../vendor/kernel/velaros-ai-kernel-sdk-0.2.2.tgz",
    "@velaros-ai/model-runtime": "^0.4.4",
    "@velaros-ai/system-tools": "^0.2.7",
    "@velaros-ai/ui": "^0.2.2",
    "@velaros-ai/workbench": "workspace:*",
    "@velaros-ai/workspace": "^1.2.4",
    "ahooks": "^3.9.7",
    "ai": "^6.0.168",
    "execa": "^9.6.1",
    "react-arborist": "^3.5.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sonner": "^2.0.7",
    "typescript": "^5.9.3",
    "vscode-css-languageservice": "^6.3.10",
    "vscode-html-languageservice": "^5.6.2",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.1.0",
    "zod": "^4.3.6",
    "@velaros-ai/kernel-client": "file:../../vendor/kernel/velaros-ai-kernel-client-0.3.0.tgz",
    "velaros-kernel": "file:../../vendor/kernel/velaros-kernel-0.3.2.tgz"
