{
  "name": "@velaros-ai/workbench-app",
  "version": "0.3.2",
  "description": "VelarOS Workbench standalone Electron IDE application.",
  "author": "VelarOS",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "probe:watch": "bun --conditions=source src/main/workspace/watch/watchProbe.ts",
    "probe:terminal": "bun --conditions=source src/main/workspace/terminal/terminalProbe.ts",
    "probe:git": "bun --conditions=source src/main/workspace/git/gitProbe.ts",
    "probe:agent-mods": "bun --conditions=source src/main/kernel/agentModRuntimeProbe.ts",
    "probe:kernel-host": "bun --conditions=source src/main/kernel/kernelHostProbe.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.10",
    "@phosphor-icons/react": "^2.1.10",
    "@velaros-ai/agent": "^0.5.0",
    "@velaros-ai/browser": "^0.2.6",
    "@velaros-ai/core": "^0.3.2",
    "@velaros-ai/model": "^0.4.6",
    "@velaros-ai/system-tools": "^0.2.8",
    "@velaros-ai/ui": "^0.2.2",
    "@velaros-ai/workspace": "^1.2.5",
    "ahooks": "^3.9.7",
    "ai": "^6.0.168",
    "diff": "^8.0.4",
    "execa": "^9.6.1",
    "pyright": "^1.1.411",
    "react-arborist": "^3.5.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sonner": "^2.0.7",
    "tinykeys": "3.0.0",
    "typescript": "^5.9.3",
    "vscode-css-languageservice": "^6.3.10",
    "vscode-html-languageservice": "^5.6.2",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.1.0",
    "zod": "^4.3.6"
  }
}
