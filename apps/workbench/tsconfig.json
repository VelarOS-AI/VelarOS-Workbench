{
  "compilerOptions": {
    "baseUrl": "../..",
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@velaros-ai/workbench": ["./packages/workbench/src/index.ts"],
      "@velaros-ai/workbench/*": ["./packages/workbench/src/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["node", "electron-vite/node"]
  },
  "include": [
    "../../types/velaros-globals.d.ts",
    "../../packages/workbench/src/types/tinykeys.d.ts",
    "electron.vite.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts"
  ]
}
