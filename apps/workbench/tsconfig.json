{
  "compilerOptions": {
    "baseUrl": "../..",
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@workbench": ["./apps/workbench/src/workbench/index.ts"],
      "@workbench/*": ["./apps/workbench/src/workbench/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["node", "electron-vite/node"]
  },
  "include": [
    "../../types/velaros-globals.d.ts",
    "src/workbench/types/tinykeys.d.ts",
    "electron.vite.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts"
  ]
}
