{
  "compilerOptions": {
    "baseUrl": ".",
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@main/*": ["./src/main/*"],
      "@renderer/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/shared/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["node", "electron-vite/node"]
  },
  "include": [
    "types/velaros-globals.d.ts",
    "src/renderer/src/types/tinykeys.d.ts",
    "electron.vite.config.ts",
    "scripts/test/verifyProjectTools.ts",
    "scripts/test/projectSurfaceNaturalAcceptance.ts",
    "tests/workbench-context-recall.test.ts",
    "tests/workbench-context-persistence.test.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts"
  ]
}
